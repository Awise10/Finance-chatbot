# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Comma-separated list of origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_64_byte_random_hex
JWT_REFRESH_SECRET=replace_me_different_64_byte_random_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── AI provider (Anthropic Claude) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Market data providers ──────────────────────────────
# Global stocks/forex: https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=your_key_here
# Global + some African coverage: https://twelvedata.com
TWELVE_DATA_API_KEY=your_key_here
# Crypto, no key required: https://www.coingecko.com/en/api
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Nigerian equities (unofficial/community source — verify before production use)
NGX_DATA_BASE_URL=https://afx.kwayisi.org/ngx
# News (optional): https://newsapi.org or https://www.marketaux.com
NEWS_API_KEY=your_key_here

# ── Database ────────────────────────────────────────────
SQLITE_DB_PATH=./data/app.db

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
CHAT_RATE_LIMIT_MAX_REQUESTS=10

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
